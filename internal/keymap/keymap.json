[
  {"id":"launcher","label":"Launcher / menu","kind":"keep","omarchy":"SUPER + Space","protected":true},
  {"id":"system-menu","label":"System menu","kind":"keep","omarchy":"SUPER + Escape"},
  {"id":"close","label":"Close window","kind":"keep","omarchy":"SUPER + Q"},
  {"id":"fullscreen","label":"Fullscreen","kind":"keep","omarchy":"SUPER + F"},
  {"id":"terminal","label":"Terminal","kind":"keep","omarchy":"SUPER + Return"},
  {"id":"screenshot","label":"Screenshot","kind":"keep","omarchy":"Print"},

  {"id":"group","label":"Group windows (tabs)","kind":"align","bind":"column.tabbed","omarchy":"SUPER + G"},
  {"id":"float","label":"Toggle tiling/floating","kind":"align","bind":"window.float","omarchy":"SUPER + T"},
  {"id":"lock","label":"Lock screen","kind":"align","bind":"shell.lock","omarchy":"SUPER + CTRL + L"},

  {"id":"copy","label":"Copy","kind":"add","omarchy":"SUPER + C","omarchy_label":"Universal copy","lua":"iokb_clipboard(\"CTRL\", \"C\", \"CTRL SHIFT\", \"C\")"},
  {"id":"cut","label":"Cut","kind":"add","omarchy":"SUPER + X","omarchy_label":"Universal cut","lua":"iokb_clipboard(\"CTRL\", \"X\")"},
  {"id":"paste","label":"Paste","kind":"add","omarchy":"SUPER + V","omarchy_label":"Universal paste","lua":"iokb_clipboard(\"CTRL\", \"V\", \"CTRL SHIFT\", \"V\")"},

  {"id":"next-workspace","label":"Next workspace","kind":"add","omarchy":"SUPER + Tab","lua":"hl.dsp.focus({ workspace = \"r+1\" })"},
  {"id":"prev-workspace","label":"Previous workspace","kind":"add","omarchy":"SUPER + SHIFT + Tab","lua":"hl.dsp.focus({ workspace = \"r-1\" })"},

  {"id":"scratch","label":"Scratchpad","kind":"align","bind":"workspace.scratchpad","omarchy":"SUPER + grave"},
  {"id":"scratch-s","label":"Scratchpad (Super+S)","kind":"add","omarchy":"SUPER + S","lua":"hl.dsp.exec_cmd(iokb_ws() .. \" scratch\")"},
  {"id":"hide","label":"Send window to scratchpad","kind":"add","omarchy":"SUPER + ALT + S","lua":"hl.dsp.exec_cmd(iokb_ws() .. \" hide\")"},

  {"id":"window-monitor-left","label":"Send window to screen left","kind":"align","bind":"display.moveWindow.left","omarchy":"SUPER + SHIFT + CTRL + Left"},
  {"id":"window-monitor-right","label":"Send window to screen right","kind":"align","bind":"display.moveWindow.right","omarchy":"SUPER + SHIFT + CTRL + Right"},
  {"id":"window-monitor-up","label":"Send window to screen up","kind":"align","bind":"display.moveWindow.up","omarchy":"SUPER + SHIFT + CTRL + Up"},
  {"id":"window-monitor-down","label":"Send window to screen down","kind":"align","bind":"display.moveWindow.down","omarchy":"SUPER + SHIFT + CTRL + Down"},
  {"id":"workspace-monitor-left","label":"Send workspace to screen left","kind":"align","bind":"display.moveWorkspace.left","omarchy":"SUPER + SHIFT + ALT + Left"},
  {"id":"workspace-monitor-right","label":"Send workspace to screen right","kind":"align","bind":"display.moveWorkspace.right","omarchy":"SUPER + SHIFT + ALT + Right"},
  {"id":"workspace-monitor-up","label":"Send workspace to screen up","kind":"align","bind":"display.moveWorkspace.up","omarchy":"SUPER + SHIFT + ALT + Up"},
  {"id":"workspace-monitor-down","label":"Send workspace to screen down","kind":"align","bind":"display.moveWorkspace.down","omarchy":"SUPER + SHIFT + ALT + Down"},

  {"id":"maximize","label":"Full width","kind":"add","omarchy":"SUPER + ALT + F","lua":"hl.dsp.window.fullscreen({ mode = \"maximized\" })"},
  {"id":"browser","label":"Browser","kind":"add","omarchy":"SUPER + SHIFT + Return","lua":"hl.dsp.exec_cmd(\"ryoku-app browser\")"},
  {"id":"files","label":"File manager","kind":"add","omarchy":"SUPER + SHIFT + F","lua":"hl.dsp.exec_cmd(\"ryoku-app files\")"},
  {"id":"editor","label":"Editor","kind":"add","omarchy":"SUPER + SHIFT + N","lua":"hl.dsp.exec_cmd(\"ryoku-app editor\")"},
  {"id":"btop","label":"btop","kind":"add","omarchy":"SUPER + SHIFT + T","lua":"hl.dsp.exec_cmd(\"kitty -e btop\")"},
  {"id":"color-picker","label":"Colour picker","kind":"add","omarchy":"SUPER + Print","lua":"hl.dsp.exec_cmd(\"hyprpicker -a\")"},
  {"id":"dictation","label":"Dictation","kind":"add","omarchy":"SUPER + CTRL + X","lua":"hl.dsp.exec_cmd(\"ryoku-shell voice\")"},
  {"id":"share","label":"Share (LocalSend)","kind":"add","omarchy":"SUPER + CTRL + S","lua":"hl.dsp.exec_cmd(\"localsend\")"},

  {"id":"wallpaper","label":"Wallpaper / theme picker","kind":"align","bind":"shell.wallpaper","omarchy":"SUPER + CTRL + W"},
  {"id":"close-w","label":"Close window (Super+W)","kind":"add","omarchy":"SUPER + W","lua":"iokb_close()"},
  {"id":"app-grid","label":"App grid","kind":"skip","omarchy":"SUPER + ALT + Space","reason":"Ryoku binds this chord to Rashin and has no separate app grid."},
  {"id":"split-position","label":"Toggle split position","kind":"skip","omarchy":"SUPER + J","reason":"Ryoku binds Super+J to Ryotunes and has no dwindle split toggle."},
  {"id":"sticky-float","label":"Sticky floating window","kind":"skip","omarchy":"SUPER + O","reason":"Ryoku binds Super+O to Notes; there is no sticky-floating action."},
  {"id":"pseudo-window","label":"Pseudo window","kind":"skip","omarchy":"SUPER + P","reason":"Ryoku binds Super+P to its monitor layout toggle."},
  {"id":"layout-cycle","label":"Cycle layouts","kind":"skip","omarchy":"SUPER + L","reason":"Ryoku has no layout cycle; moving lock to Super+Ctrl+L frees this chord."},
  {"id":"layout-cycle-reverse","label":"Cycle layouts (reverse)","kind":"skip","omarchy":"SUPER + ALT + L","reason":"Ryoku has no layout cycle."},
  {"id":"group-cycle","label":"Cycle windows in group","kind":"skip","omarchy":"SUPER + ALT + Tab","reason":"Ryoku uses this chord for overview-by-desktop."},
  {"id":"group-navigation","label":"Navigate inside a group","kind":"skip","omarchy":"SUPER + CTRL + Left","reason":"Ryoku resizes with Ctrl+arrows; Super+arrows already walks a group."},
  {"id":"resize-steps","label":"Resize in steps","kind":"skip","omarchy":"SUPER + Minus","reason":"Ryoku resizes with Super+Ctrl+arrows."},
  {"id":"zoom","label":"Zoom the screen","kind":"skip","omarchy":"SUPER + CTRL + Z","reason":"No equivalent action in Ryoku."},
  {"id":"monitor-scale","label":"Cycle monitor scaling","kind":"skip","omarchy":"SUPER + /","reason":"No equivalent action in Ryoku."},
  {"id":"panels","label":"Audio / Bluetooth / Wi-Fi / Display / Power panels","kind":"skip","omarchy":"SUPER + CTRL + A","reason":"Ryoku has one quick-settings surface on Super+Escape."},
  {"id":"notifications","label":"Dismiss notification","kind":"skip","omarchy":"SUPER + comma","reason":"Super+comma is Ryoku Settings and is always preserved."},
  {"id":"theme","label":"Theme / background picker","kind":"skip","omarchy":"SUPER + CTRL + T","reason":"Ryoku themes through the wallpaper picker on Super+Ctrl+W."},
  {"id":"topbar","label":"Toggle the top bar","kind":"skip","omarchy":"SUPER + SHIFT + Space","reason":"No bar toggle action in Ryoku."},
  {"id":"gaps","label":"Toggle window gaps","kind":"skip","omarchy":"SUPER + SHIFT + Backspace","reason":"Gaps are a Ryoku Hub setting, not a toggle."},
  {"id":"idle-lock","label":"Toggle lock on idle","kind":"skip","omarchy":"SUPER + CTRL + I","reason":"Idle locking is configured in Ryoku Hub > Graphics & Power."},
  {"id":"music","label":"Music (Spotify)","kind":"skip","omarchy":"SUPER + SHIFT + M","reason":"Spotify is not installed; Ryoku keeps Ryotunes on Super+J and the visualiser on Shift+M."},
  {"id":"private-browser","label":"Private browser","kind":"skip","omarchy":"SUPER + SHIFT + ALT + B","reason":"Ryoku has no private-window action."},
  {"id":"tmux","label":"Tmux terminal","kind":"skip","omarchy":"SUPER + ALT + Return","reason":"tmux is not installed."},
  {"id":"herdr","label":"Herdr agent manager","kind":"skip","omarchy":"SUPER + CTRL + Return","reason":"Herdr is not part of Ryoku."},
  {"id":"calculator","label":"Calculator","kind":"skip","omarchy":"SUPER + SHIFT + Q","reason":"No calculator is installed."},
  {"id":"obsidian","label":"Obsidian","kind":"skip","omarchy":"SUPER + SHIFT + O","reason":"Obsidian is not installed; Notes stays on Super+O."},
  {"id":"signal","label":"Signal","kind":"skip","omarchy":"SUPER + SHIFT + G","reason":"Signal is not installed."},
  {"id":"email","label":"Email","kind":"skip","omarchy":"SUPER + SHIFT + E","reason":"No mail client is configured."}
]
